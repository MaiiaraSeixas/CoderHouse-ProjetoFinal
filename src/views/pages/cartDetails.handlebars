<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <!-- Define a codificação de caracteres da página -->
  <meta charset="UTF-8">
  <!-- Título que aparece na aba do navegador -->
  <title>Meu Carrinho</title>

  <!-- Estilos CSS da página -->
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      max-width: 800px;
      margin: auto;
    }

    .card {
      border: 1px solid #ccc;
      padding: 15px;
      margin-bottom: 10px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-info {
      flex-grow: 1;
    }

    .card-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .card h3 {
      margin-top: 0;
    }

    .total {
      font-weight: bold;
      margin-top: 20px;
      font-size: 18px;
    }

    .cart-summary {
      margin-top: 20px;
      border-top: 2px solid #333;
      padding-top: 10px;
    }

    .btn {
      padding: 8px 12px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }

    .btn-update {
      background-color: #ffc107;
    }

    .btn-remove {
      background-color: #dc3545;
      color: white;
    }

    .btn-clear {
      background-color: #6c757d;
      color: white;
    }

    .btn-purchase {
      background-color: #28a745;
      color: white;
      font-size: 16px;
      padding: 12px 20px;
    }

    input[type="number"] {
      width: 60px;
      text-align: center;
    }

    #payment-form {
      margin-top: 20px;
    }

    .hidden {
      display: none;
    }
  </style>
</head>

<body>
  <!-- Título principal da página -->
  <h1>🛒 Meu Carrinho</h1>

  <!-- Verifica se o carrinho está vazio -->
  {{#if empty}}
  <p>Seu carrinho está vazio.</p>
  {{else}}
  <!-- Lista de produtos no carrinho -->
  <div id="cart-items">
    {{#each products}}
    <div class="card">
      <!-- Informações do produto -->
      <div class="card-info">
        <h3>{{this.product.title}}</h3>
        <p>Preço unitário: R$ {{this.product.price}}</p>
        <p>Subtotal: R$ {{multiply this.quantity this.product.price}}</p>
      </div>

      <!-- Botões de ação para cada produto -->
      <div class="card-actions">
        <div>
          <!-- Input para alterar a quantidade do produto -->
          <input type="number" value="{{this.quantity}}" min="1" id="quantity-{{this.product._id}}">
          <button class="btn btn-update"
            onclick="updateQuantity('{{../cartId}}', '{{this.product._id}}')">Atualizar</button>
        </div>
        <!-- Botão para remover o produto do carrinho -->
        <button class="btn btn-remove" onclick="removeProduct('{{../cartId}}', '{{this.product._id}}')">Remover</button>
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Resumo do carrinho com total e ações -->
  <div class="cart-summary" id="cart-summary">
    <p class="total">Total: R$ {{calculateTotal products}}</p>
    <button class="btn btn-purchase" id="purchase-btn">Finalizar Compra</button>

    <button class="btn btn-clear" onclick="clearCart('{{cartId}}')">Limpar Carrinho</button>
  </div>
  <!-- Formulário de pagamento da Stripe (inicialmente oculto) -->
  <div id="payment-section" class="hidden">
    <h3>Pagamento</h3>
    <form id="payment-form">
      <div id="payment-element"></div>
      <button id="submit-payment" class="btn btn-purchase">Pagar</button>
      <div id="payment-message" role="alert"></div>
    </form>
  </div>


  {{/if}}

  <!-- Link para voltar para a página de produtos -->
  <br>
  <a href="/products">⬅ Voltar para Produtos</a>

  <script>
    // Inicializa o Stripe.js

    const stripe = Stripe('{{stripePublishableKey}}');
    let elements;

    document.getElementById('purchase-btn').addEventListener('click', async () => {
      try {
        const response = await fetch('/api/carts/{{cartId}}/purchase', { method: 'POST' });
        const { payload } = await response.json();
        const clientSecret = payload.client_secret;

        elements = stripe.elements({ clientSecret });
        const paymentElement = elements.create('payment');
        paymentElement.mount('#payment-element');

        document.getElementById('cart-summary').classList.add('hidden');
        document.getElementById('payment-section').classList.remove('hidden');
      } catch (error) {
        alert('Erro ao iniciar o pagamento: ' + error.message);
      }
    });

    document.getElementById('payment-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      setLoading(true);

      const { error } = await stripe.confirmPayment({
        elements,
        confirmParams: {
          return_url: window.location.href.split('?')[0] + '?payment_success=true',
        },
      });

      if (error) {
        showMessage(error.message);
        setLoading(false);
      }
    });

    // Funções de UI
    function showMessage(messageText) {
      const messageContainer = document.querySelector('#payment-message');
      messageContainer.textContent = messageText;
    }

    function setLoading(isLoading) {
      const submitBtn = document.querySelector('#submit-payment');
      if (isLoading) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Processando...';
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Pagar';
      }
    }
    async function removeProduct(cartId, productId) {
      if (!confirm('Tem a certeza de que quer remover este produto?')) return;

      try {
        // Requisição DELETE para a API para remover o produto
        const response = await fetch(`/api/carts/${cartId}/product/${productId}`, { method: 'DELETE' });
        if (!response.ok) throw new Error('Falha ao remover produto.');
        alert('Produto removido com sucesso!');
        window.location.reload(); // Atualiza a página
      } catch (err) {
        alert(`Erro: ${err.message}`);
      }
    }

    // Função para atualizar a quantidade de um produto
    async function updateQuantity(cartId, productId) {
      const quantityInput = document.getElementById(`quantity-${productId}`);
      const quantity = parseInt(quantityInput.value);

      if (isNaN(quantity) || quantity < 1) {
        alert('Por favor, insira uma quantidade válida.');
        return;
      }

      try {
        // Requisição PUT para a API para atualizar a quantidade
        const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quantity })
        });
        if (!response.ok) throw new Error('Falha ao atualizar a quantidade.');
        alert('Quantidade atualizada!');
        window.location.reload();
      } catch (err) {
        alert(`Erro: ${err.message}`);
      }
    }

    // Função para limpar todo o carrinho
    async function clearCart(cartId) {
      if (!confirm('Tem a certeza de que quer esvaziar o carrinho?')) return;
      try {
        // Requisição DELETE para a API para limpar o carrinho
        const response = await fetch(`/api/carts/${cartId}`, { method: 'DELETE' });
        if (!response.ok) throw new Error('Falha ao limpar o carrinho.');
        alert('Carrinho esvaziado com sucesso!');
        window.location.reload();
      } catch (err) {
        alert(`Erro: ${err.message}`);
      }
    }


  </script>
</body>

</html>