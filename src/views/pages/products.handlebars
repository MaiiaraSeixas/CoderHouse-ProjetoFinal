<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Produtos</title>
  <style>
    .product-item { border: 1px solid #ccc; padding: 10px; margin-bottom: 10px; }
    .pagination a, .pagination span { margin-right: 5px; padding: 5px; border: 1px solid #eee; }
    .pagination .current { font-weight: bold; }
  </style>
</head>
<body>
  <h1>Lista de Produtos</h1>

  {{#if user}}
  <div class="user-info">
    <p>👋 Bem-vindo, {{user.first_name}}! Você está logado como <strong>{{user.role}}</strong>.</p>
    <p><a href="/api/sessions/logout">Sair</a></p>
  </div>
  {{/if}}

  <ul class="products-list">
    {{#each products}}
    <li class="product-item">
      <h3>{{this.title}}</h3>
      <p><em>{{this.description}}</em></p>
      <p>Preço: R$ {{this.price}}</p>
      <p>Categoria: {{this.category}}</p>
      <div class="product-actions">
        {{#if (gt this.stock 0)}}
          <button onclick="adicionarAoCarrinho('{{this._id}}')">Adicionar ao Carrinho</button>
        {{else}}
          <span style="color: red">Produto esgotado</span>
        {{/if}}
        <a href="/products/{{this._id}}/view">Ver Detalhes</a>
      </div>
    </li>
    {{else}}
    <li>Nenhum produto encontrado.</li>
    {{/each}}
  </ul>

  <div class="pagination">
    {{#if prevLink}}
      <a href="{{prevLink}}">Página Anterior</a>
    {{/if}}
    <span class="current-page">Página {{currentPage}} de {{totalPages}}</span>
    {{#if nextLink}}
      <a href="{{nextLink}}">Próxima Página</a>
    {{/if}}
  </div>

  <script>
    // --- SCRIPT CORRIGIDO ---
    async function adicionarAoCarrinho(productId) {
      // Lê a variável 'cartId' que foi renderizada diretamente no template.
      const cartId = '{{cartId}}';

      if (!cartId) {
        alert('Erro: ID do carrinho não encontrado. Tente fazer login novamente.');
        return;
      }

      try {
        const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quantity: 1 })
        });
        const data = await response.json();
        if (response.ok) {
          alert('Produto adicionado ao carrinho com sucesso!');
        } else {
          throw new Error(data.error || 'Falha ao adicionar produto');
        }
      } catch (err) {
        console.error('Erro:', err);
        alert(`Erro: ${err.message}`);
      }
    }
  </script>
</body>
</html>