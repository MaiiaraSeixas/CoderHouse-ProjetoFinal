<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Produtos</title>
</head>
<body>
  <h1>Produtos</h1>
  <ul>
  {{#each products}}
    <li>
      <strong>{{title}}</strong> - Preço: R$ {{price}} <br>
      <em>{{description}}</em>
    </li>
  {{/each}}
</ul>
</body>
</html>
