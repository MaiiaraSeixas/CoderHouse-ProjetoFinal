<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Lista de Produtos</title>
    <style>
        .product-item { border: 1px solid #ccc; padding: 10px; margin-bottom: 10px; }
        .pagination a, .pagination span { margin-right: 5px; padding: 5px; border: 1px solid #eee; }
        .pagination .current { font-weight: bold; }
    </style>
</head>
<body>
    <h1>Lista de Produtos</h1>

    <ul>
        {{#each products}}
            <li class="product-item">
                <h3>{{this.title}}</h3>
                <p><em>{{this.description}}</em></p>
                <p>Preço: R$ {{this.price}}</p>
                <p>Categoria: {{this.category}}</p>
                <button onclick="adicionarAoCarrinho('{{this._id}}')">Adicionar ao Carrinho</button>
                <a href="/products/{{this._id}}">Ver Detalhes</a>
            </li>
        {{else}}
            <li>Nenhum produto encontrado.</li>
        {{/each}}
    </ul>

    <div class="pagination">
        {{#if hasPrevPage}}
        <a href="/products?page={{prevPage}}&limit={{limit}}">Página Anterior</a>
        {{/if}}
        <span>Página {{currentPage}} de {{totalPages}}</span>
        {{#if hasNextPage}}
        <a href="/products?page={{nextPage}}&limit={{limit}}">Próxima Página</a>
        {{/if}}
    </div>


    <script>
    async function adicionarAoCarrinho(productId) {
        let cartId = localStorage.getItem('cartId');

        // Se não houver um cartId no localStorage, cria um novo no servidor e salva no localStorage
        if (!cartId) {
            try {
                const response = await fetch('/api/carts', { method: 'POST' });
                if (response.ok) {
                    const newCart = await response.json();
                    cartId = newCart._id;
                    localStorage.setItem('cartId', cartId);
                } else {
                    console.error('Erro ao criar novo carrinho.');
                    alert('Erro ao adicionar ao carrinho.');
                    return;
                }
            } catch (error) {
                console.error('Erro ao comunicar com o servidor para criar carrinho:', error);
                alert('Erro ao adicionar ao carrinho.');
                return;
            }
        }

        try {
            const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
            });

            if (response.ok) {
                const result = await response.json();
                console.log('Produto adicionado ao carrinho:', result);
                alert('Produto adicionado ao carrinho com sucesso!');
                // Opcional: Redirecionar o usuário para a página do carrinho
                // window.location.href = `/carts/${cartId}`;
            } else {
                const error = await response.json();
                console.error('Erro ao adicionar produto ao carrinho:', error);
                alert('Erro ao adicionar produto ao carrinho.');
            }
        } catch (error) {
            console.error('Erro de rede ao adicionar produto ao carrinho:', error);
            alert('Erro ao adicionar produto ao carrinho.');
        }
    }
</script>
</body>
</html>