<!-- ====== products.handlebars (Corrigido) ====== -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <title>Lista de Produtos</title>
  <!-- Estilos personalizados para a página -->
  <style>
    .product-item {
      border: 1px solid #ccc;
      padding: 10px;
      margin-bottom: 10px;
    }

    .pagination a,
    .pagination span {
      margin-right: 5px;
      padding: 5px;
      border: 1px solid #eee;
    }

    .pagination .current {
      font-weight: bold;
    }
  </style>
</head>

<body>
  <h1>Lista de Produtos</h1>

  <!-- Seção de informações do usuário logado -->
  {{#if user}}
  <div class="user-info">
    <p>👋 Bem-vindo, {{user.name}}! Você está logado como <strong>{{user.role}}</strong>.</p>
    <p><a href="/logout">Sair</a></p>
  </div>
  {{/if}}

  <!-- Lista de produtos -->
  <ul class="products-list">
    {{#each products}}
    <li class="product-item">
      <!-- Detalhes do produto -->
      <h3>{{this.title}}</h3>
      <p><em>{{this.description}}</em></p>
      <p>Preço: R$ {{this.price}}</p>
      <p>Categoria: {{this.category}}</p>

      <!-- Ações disponíveis para o produto -->
      <div class="product-actions">
        {{#if (gt this.stock 0)}}
        <!-- Botão de adição ao carrinho -->
        <button onclick="adicionarAoCarrinho('{{this._id}}')">Adicionar ao Carrinho</button>
        {{else}}
        <!-- Mensagem de estoque esgotado -->
        <span style="color: red">Produto esgotado</span>
        {{/if}}
        <!-- Link para detalhes do produto -->
        <a href="/products/{{this._id}}">Ver Detalhes</a>
      </div>
    </li>
    {{else}}
    <!-- Mensagem para lista vazia -->
    <li>Nenhum produto encontrado.</li>
    {{/each}}
  </ul>

  <!-- Controle de paginação -->
  <div class="pagination">
    {{#if hasPrevPage}}
    <a href="/products?page={{prevPage}}&limit={{limit}}">Página Anterior</a>
    {{/if}}
    <!-- Indicador de página atual -->
    <span class="current-page">Página {{currentPage}} de {{totalPages}}</span>
    {{#if hasNextPage}}
    <a href="/products?page={{nextPage}}&limit={{limit}}">Próxima Página</a>
    {{/if}}
  </div>

  <!-- Scripts de interação com o carrinho -->
  <script>
    // Pega o cartId passado pelo backend (sessão)
    const cartId = '{{cartId}}';

    // Função para adicionar produto ao carrinho
    async function adicionarAoCarrinho(productId) {
      try {
        const quantity = 1; // Quantidade padrão

        if (!cartId || cartId === 'null') {
          throw new Error('Carrinho não encontrado na sessão.');
        }

        // Requisição para API de carrinhos
        const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quantity })
        });

        // Processamento da resposta
        const data = await response.json();
        if (data && !data.error) {
          alert('Produto adicionado ao carrinho!');
        } else {
          throw new Error(data.error || 'Erro desconhecido');
        }
      } catch (err) {
        console.error('Erro:', err);
        alert(`Erro: ${err.message}`);
      }
    }
  </script>

</body>

</html>