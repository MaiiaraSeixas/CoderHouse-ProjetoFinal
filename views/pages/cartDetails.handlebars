<!-- ====== cartDetails.handlebars (Corrigido) ====== -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <title>Meu Carrinho</title>
  <!-- Estilos da página do carrinho -->
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }

    .card {
      border: 1px solid #ccc;
      padding: 15px;
      margin-bottom: 10px;
      border-radius: 8px;
    }

    .card h3 {
      margin-top: 0;
    }

    .total {
      font-weight: bold;
      margin-top: 20px;
      font-size: 18px;
    }
  </style>
</head>

<body>
  <h1>🛒 Meu Carrinho</h1>

  <!-- Verificação de carrinho vazio -->
  {{#if empty}}
  <p>Seu carrinho está vazio.</p>
  {{else}}
  <!-- Listagem de produtos do carrinho -->
  {{#each products}}
  <div class="card">
    <!-- Informações do produto -->
    <h3>{{this.product.title}}</h3>
    <p>{{this.product.description}}</p>
    <p>Categoria: {{this.product.category}}</p>
    <p>Preço unitário: R$ {{this.product.price}}</p>

    <!-- Detalhes da quantidade e subtotal -->
    <p>Quantidade: {{this.quantity}}</p>
    <p>Subtotal: R$ {{multiply this.quantity this.product.price}}</p>
  </div>
  {{/each}}

  <!-- Cálculo do total geral usando helper -->
  <p class="total">Total: R$ {{calculateTotal products}}</p>
  {{/if}}

  <!-- Link de navegação de retorno -->
  <br>
  <a href="/products">⬅ Voltar para Produtos</a>
</body>

</html>